{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2016",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",

    /* JSON and Imports */
    "resolveJsonModule": true,
    "esModuleInterop": true,

    /* Base Url and Paths */
    "baseUrl": ".",

    /* Strictness */
    "strict": true,
    "forceConsistentCasingInFileNames": true,

    /* Skip type checking for declaration files */
    "skipLibCheck": true
  },

  "include": [
    "src/**/*",
    "repos.config.json",
    "ManualFolder/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}
